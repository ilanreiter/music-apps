# Copy this file to .env and fill in real values before running docker compose.

# Postgres (external server)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backend auth
JWT_SECRET=replace-with-a-long-random-string
# Set to true only once the app is served over HTTPS (a bare-HTTP deployment,
# e.g. plain localhost, must keep this false or the session cookie won't stick)
COOKIE_SECURE=false

# AI integration (get a key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Where the frontend is served from (used for CORS on the API)
CLIENT_ORIGIN=http://localhost:8080
CLIENT_PORT=8080

# Optional: seed a second household member on first `npm run seed`
SEED_USER1_EMAIL=you@example.com
SEED_USER1_NAME=You
SEED_USER1_PASSWORD=changeme123
SEED_USER2_EMAIL=
SEED_USER2_NAME=Partner
SEED_USER2_PASSWORD=

# Optional: trip Inbox. A dedicated mailbox (NOT your personal one) that you forward trip emails to.
# Gmail: enable 2-step verification, then create an app password at https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Shared mailbox: only take mail sent to <mailbox>+<alias>@gmail.com (e.g. alias "travel" for myhub+travel@gmail.com).
INBOX_ALIAS=travel
# Comma-separated sender addresses allowed to forward mail in (your own addresses). Empty = accept anyone.
INBOX_ALLOWED_SENDERS=
INBOX_POLL_MINUTES=5

# Optional: NAS share (host path) mounted into the server for original trip documents. The folder inside it is chosen in Preferences.
DOCS_NAS_ROOT=/mnt/ugreen-ssd1
