# Copy this file to .env and fill in real values before running docker compose.

# Postgres
POSTGRES_USER=travel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=travel

# Backend auth
JWT_SECRET=replace-with-a-long-random-string
# Set to true only once the app is served over HTTPS (a bare-HTTP deployment,
# e.g. plain localhost, must keep this false or the session cookie won't stick)
COOKIE_SECURE=false

# AI integration (get a key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Where the frontend is served from (used for CORS on the API)
CLIENT_ORIGIN=http://localhost:8080
CLIENT_PORT=8080

# Optional: seed a second household member on first `npm run seed`
SEED_USER1_EMAIL=you@example.com
SEED_USER1_NAME=You
SEED_USER1_PASSWORD=changeme123
SEED_USER2_EMAIL=
SEED_USER2_NAME=Partner
SEED_USER2_PASSWORD=
