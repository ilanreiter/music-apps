generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DestinationStatus {
  IDEA
  RESEARCHING
  PLANNED
  BOOKED
  VISITED
  ARCHIVED
}

enum TripStatus {
  DRAFT
  PLANNING
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripItemType {
  TRANSPORT
  STAY
  POI
  ACTIVITY
  OTHER
}

enum BookingStatus {
  IDEA
  RESEARCHING
  READY_TO_BOOK
  BOOKED
  CONFIRMED
  CANCELLED
}

enum BudgetCategory {
  TRANSPORT
  FLIGHTS
  FUEL
  LODGING
  FOOD
  ACTIVITIES
  OTHER
}

enum TripPlanningType {
  SELF_PLANNED
  GROUP
  ORGANIZED
}

enum TripGoal {
  NATURE
  SIGHTSEEING
  CITY
  RELAXATION
  ADVENTURE
  MIXED
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Destination {
  id          String            @id @default(cuid())
  name        String
  country     String?
  countryCode String?
  region      String?
  notes       String?
  status      DestinationStatus @default(IDEA)
  priority    Int               @default(0)
  tags        String[]          @default([])
  imageUrl    String?
  roughCostEstimate Float?
  bestSeason  String?
  // Roadmap fields — planYear is null for unscheduled ideas and for visited places.
  planYear      Int?
  planSeason    String?
  tier          String?
  isFar         Boolean  @default(false)
  days          Int?
  dailyCost     Float?
  transitCost   Float?
  mobility      String?
  secondSeason  String?
  weather       String?
  weatherAlt    String?
  lat           Float?
  lng           Float?
  suggestedYear   Int?
  suggestedSeason String?
  suggestedPriority Int?
  pinned        Boolean  @default(false)
  // Cost multiplier per season relative to the listed (best-season) cost, e.g. {"Summer":1.25,"Fall":0.9}
  seasonFactors Json?
  pairingId     String?
  pairing       Pairing? @relation(fields: [pairingId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  trips       Trip[]
  resources   Resource[]
}

model Trip {
  id            String       @id @default(cuid())
  title         String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  startDate     DateTime?
  endDate       DateTime?
  durationNights Int?
  travelSeason  String?
  planningType  TripPlanningType?
  goal          TripGoal?
  goalDetail    String?
  status        TripStatus   @default(DRAFT)
  travelers     String[]     @default([])
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         TripItem[]
  budgetLines   BudgetLine[]
  resources     Resource[]
  aiMessages    AiMessage[]
  checklist     ChecklistItem[]
}

model TripItem {
  id              String        @id @default(cuid())
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type            TripItemType
  title           String
  provider        String?
  location        String?
  lat             Float?
  lng             Float?
  startAt         DateTime?
  endAt           DateTime?
  cost            Float?
  // For STAY items, cost is derived deterministically as costPerNight * nights
  // (never trusted from the AI's own arithmetic) — these two are kept
  // alongside cost so the breakdown can be displayed. Null for other types.
  costPerNight    Float?
  nights          Int?
  currency        String?       @default("USD")
  bookingStatus   BookingStatus @default(IDEA)
  confirmationNo  String?
  bookingUrl      String?
  bookingAgentId  String?
  bookingAgent    BookingAgent? @relation(fields: [bookingAgentId], references: [id], onDelete: SetNull)
  sortOrder       Int           @default(0)
  // AI-authored rationale/what-to-expect (or logistics context, e.g. a gas
  // stop's mileage basis) — set by propose/import, never edited by the user.
  notes           String?
  // The user's own free-text notes on this item — kept separate from `notes`
  // so regenerating/re-importing the AI's notes never clobbers what the user
  // wrote themselves.
  userNotes       String?
  // Booking management: last day to cancel for free, and whether it has been paid.
  freeCancelUntil DateTime?
  paid            Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BudgetLine {
  id          String         @id @default(cuid())
  tripId      String
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    BudgetCategory
  label       String
  estimated   Float          @default(0)
  actual      Float?
  currency    String         @default("USD")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model BookingAgent {
  id        String     @id @default(cuid())
  name      String
  type      String?
  contact   String?
  website   String?
  notes     String?
  createdAt DateTime   @default(now())
  items     TripItem[]
}

model Resource {
  id            String       @id @default(cuid())
  title         String
  url           String?
  category      String?
  notes         String?
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  tripId        String?
  trip          Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

// One row per traveler — used to steer AI-proposed itineraries, cost
// estimates, and to give booking agents the details they need (names, ages,
// dietary/mobility notes, etc).
model Traveler {
  id                    String   @id @default(cuid())
  name                  String
  age                   Int?
  homeLocation          String?
  avatarEmoji           String?
  photoUrl              String?  @db.Text
  travelPreferences     String?
  stayPreferences       String?
  transportPreferences  String?
  foodPreferences       String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Singleton (id is always "default") — shared household travel preferences
// used to steer AI-proposed itineraries and cost estimates.
model Preferences {
  id          String   @id @default("default")
  interests   String[] @default([])
  pace        String?
  budgetStyle String?
  notes       String?
  updatedAt   DateTime @updatedAt
}

model AiMessage {
  id        String   @id @default(cuid())
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

// A regional pairing: several destinations flown as one trip, saving airfare.
model Pairing {
  id           String        @id @default(cuid())
  name         String
  year         Int?
  quarter      String?
  savings      Float         @default(0)
  destinations Destination[]
}

// Singleton (id is always "default") — roadmap horizon and guardrails.
model RoadmapSettings {
  id                  String @id @default("default")
  startYear           Int    @default(2027)
  endYear             Int    @default(2034)
  annualCap           Float  @default(30000)
  maxFarPerYear       Int    @default(2)
  ageA                Int?
  ageB                Int?
  highMobilityUntil   Int?
  ruleOrder           String[] @default([])
  ruleDisabled        String[] @default([])
  autoOrder           Boolean @default(false)
}

// A pre-trip to-do (visa, insurance, packing, ...) in a trip's checklist.
model ChecklistItem {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text      String
  category  String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}
